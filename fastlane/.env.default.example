# Copy to fastlane/.env.default (git-ignored) and fill in. Create the key in
# App Store Connect > Users and Access > Integrations > App Store Connect API (role: App Manager).
ASC_KEY_ID=ABC123DEFG
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_KEY_PATH=/absolute/path/to/AuthKey_ABC123DEFG.p8
# Or inline instead of ASC_KEY_PATH (CI): ASC_KEY_CONTENT="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
